{
  "name": "orders-demo",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/guiyomh/features/just:0": {}
  },
  // Testcontainers and `just dev` start sibling containers on the host's Docker;
  // reach their published ports through host.docker.internal.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "containerEnv": {
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "DEV_DB_HOST": "host.docker.internal"
  },
  "forwardPorts": [8080],
  "postCreateCommand": "just setup",
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "nefrob.vscode-just-syntax", "editorconfig.editorconfig"]
    }
  }
}
