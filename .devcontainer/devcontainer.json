{
  "name": "orders-demo",
  // Built FROM the one .NET SDK image used everywhere: this devcontainer, `scripts/dotnet` on machines without
  // an SDK, and every CI job (see Dockerfile; scripts/sdk-image reads its FROM line).
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/guiyomh/features/just:0": {}
  },
  // Testcontainers and `just setup`/`just dev` start sibling containers on the host's Docker;
  // reach their published ports through host.docker.internal.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "containerEnv": {
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "DEV_DB_HOST": "host.docker.internal"
  },
  "forwardPorts": [8080],
  "postCreateCommand": "just setup",
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "nefrob.vscode-just-syntax", "editorconfig.editorconfig"]
    }
  }
}
