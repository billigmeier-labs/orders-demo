<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="API">
    <PackageVersion Include="AWSSDK.AppConfigData" Version="4.0.100.26" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.4" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.8.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Console">
    <PackageVersion Include="AWSSDK.AppConfig" Version="4.0.101.23" />
    <PackageVersion Include="AWSSDK.CloudWatch" Version="4.0.107.6" />
    <PackageVersion Include="AWSSDK.CloudWatchLogs" Version="4.0.108.2" />
    <PackageVersion Include="AWSSDK.CostExplorer" Version="4.0.101.10" />
    <PackageVersion Include="AWSSDK.ECS" Version="4.0.111.1" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.12" />
    <PackageVersion Include="AWSSDK.SimpleSystemsManagement" Version="4.0.105.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Load generator">
    <PackageVersion Include="NBomber" Version="6.7.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <!-- Pinned above AWSSDK.Extensions.CborProtocol's 9.0.5 (GHSA-vmv3-wvjp-wqpj); drop once the AWS SDK requires a patched version. -->
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
