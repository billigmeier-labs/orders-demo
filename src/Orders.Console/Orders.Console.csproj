<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Orders.Console</RootNamespace>
    <AssemblyName>Orders.Console</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.AppConfig" Version="4.0.101.22" />
    <PackageReference Include="AWSSDK.CloudWatch" Version="4.0.107.5" />
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="4.0.108.1" />
    <PackageReference Include="AWSSDK.CostExplorer" Version="4.0.101.9" />
    <PackageReference Include="AWSSDK.ECS" Version="4.0.110.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Scenarios/Definitions/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Orders.Console.Tests" />
  </ItemGroup>

</Project>
