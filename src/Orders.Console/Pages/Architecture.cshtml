    <div class="section-title">Every component, in detail</div>
    <div class="arch-zones">
        @foreach (var z in ArchitectureContent.Zones)
        {
            <div class="card arch-zone" style="flex: @z.Flex" data-zone="@z.Name">
                <div class="row-between wrap">
                    <span class="zone-title">@z.Name</span>
                    <span class="muted small">@z.Where</span>
                </div>
                <div class="arch-grid">
                    @foreach (var c in z.Items)
                    {
                        <div class="component" data-component="@c.Name">
                            <div class="row-between">
                                @if (c.Explain is not null)
                                {
                                    <button type="button" class="component-name" data-explain="@c.Explain">@c.Name</button>
                                }
                                else
                                {
                                    <span class="component-name">@c.Name</span>
                                }
                            </div>
                            <div class="component-desc">@c.Desc</div>
                            <div class="subs">
                                @foreach (var s in c.Subs)
                                {
                                    <div class="detail plain"><div class="mono detail-k">@s.K</div><div class="detail-v">@s.V</div></div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
